{
  "name": "hyperion360/kipsaas",
  "description": "Open-source SaaS starter kit for the Kip framework: multi-tenant subscriptions with production-hardened Stripe billing. Zero build step, SQLite-first.",
  "license": "MIT",
  "repositories": [{ "type": "vcs", "url": "https://github.com/Hyperion360/kip" }],
  "require": { "php": ">=8.3", "kip/framework": "^0.5@dev" },
  "require-dev": { "phpunit/phpunit": "^11" },
  "autoload": { "psr-4": { "KipSaaS\\": "src/" }, "classmap": ["src/"] },
  "autoload-dev": { "psr-4": { "KipSaaS\\Tests\\": "tests/" } },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": { "optimize-autoloader": true }
}
