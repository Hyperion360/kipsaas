if ($c2 !== 0) { fwrite(STDERR, "git commit failed\n"); exit(1); }
// core.commentChar moves git's comment marker off '#', so the ### type headings survive the
// tag message cleanup and git show vN is self-contained (no section line can start with '@').
exec('git -c core.commentChar=@ tag -a ' . escapeshellarg($tag) . ' -m ' . escapeshellarg("Release {$tag}\n\n" . substr($section, 0, 2000)), $o3, $c3);
if ($c3 !== 0) { fwrite(STDERR, "git tag failed\n"); exit(1); }
